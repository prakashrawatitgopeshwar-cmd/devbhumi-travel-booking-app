# Copy this file to .env.local. Never commit real secrets.
NEXT_PUBLIC_MAPBOX_TOKEN=
MAPBOX_ACCESS_TOKEN=
# Planned integrations: Supabase/Postgres, Razorpay, email/WhatsApp provider
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Required: set a random secret (32+ characters) before deployment
SESSION_SECRET=replace-with-a-random-32-character-or-longer-secret
# Bootstrap admin account: use only when running npm run seed:admin locally
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-14-character-password
# Server-side Mapbox token only; do not prefix with NEXT_PUBLIC_
